<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.mapper.EquipmentMapper">

    <resultMap id="BaseResultMap" type="com.lab.entity.Equipment">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="category" property="category"/>
        <result column="brand" property="brand"/>
        <result column="model" property="model"/>
        <result column="location" property="location"/>
        <result column="status" property="status"/>
        <result column="price" property="price"/>
        <result column="description" property="description"/>
        <result column="purchase_date" property="purchaseDate"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM equipment WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM equipment
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.lab.entity.Equipment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO equipment (name, code, category, brand, model, location, status, price, description, purchase_date, create_time)
        VALUES (#{name}, #{code}, #{category}, #{brand}, #{model}, #{location}, #{status}, #{price}, #{description}, #{purchaseDate}, NOW())
    </insert>

    <update id="update" parameterType="com.lab.entity.Equipment">
        UPDATE equipment
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="brand != null and brand != ''">brand = #{brand},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="price != null">price = #{price},</if>
            <if test="description != null">description = #{description},</if>
            <if test="purchaseDate != null">purchase_date = #{purchaseDate},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM equipment WHERE id = #{id}
    </delete>

</mapper>
